# Store text with LF in the repository; LICENSE stays byte-identical to
# https://www.mozilla.org/media/MPL/2.0/index.txt
* text=auto
LICENSE text eol=lf
*.ps1 text eol=crlf
# Files copied into the Firefox checkout keep LF on every platform (binary files stay binary: text=auto).
mozconfig text eol=lf
overlay/** text=auto eol=lf
